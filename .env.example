# Boş bırakılırsa PeerJS bulut sunucusu (0.peerjs.com) kullanılır.
# Kendi PeerServer'ın için:
# NEXT_PUBLIC_PEER_HOST=peer.ornek.com
# NEXT_PUBLIC_PEER_PORT=443
# NEXT_PUBLIC_PEER_PATH=/
# NEXT_PUBLIC_PEER_SECURE=true

# İstatistikler (Supabase). Boş bırakılırsa hiçbir veri gönderilmez.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# İstatistik paneli (/istatistik). İkisi de yalnızca sunucuda kullanılır, NEXT_PUBLIC_ ÖNEKİ KOYMA.
# SUPABASE_SECRET_KEY=sb_secret_...   (Supabase → Project Settings → API Keys → secret / service_role)
# STATS_PASSWORD=uzun-bir-sifre
